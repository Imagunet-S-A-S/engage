{% extends '@engage/base_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set field_options = {
    'field_class': 'col-12 col-xxl-6 col-sm-6',
    'full_width': true,
} %}

{% block config_fields %}

<div class="hr-text">
    <i class="ti ti-settings"></i>
    <span>{{ __('Engage — Automatic Engagement') }}</span>
</div>

<div class="row ps-4">

    {{ fields.dropdownYesNo(
        'is_active',
        config.fields['is_active'],
        __('Enable automatic followup'),
        { 'width': 'auto' }
    ) }}

</div>

{% if config.fields['is_active'] %}

<div class="row ps-4">

    {{ fields.dropdownArrayField(
        'ticket_type',
        config.fields['ticket_type'],
        [
            __('Incident + Request'),
            __('Incident'),
            __('Request')
        ],
        __('Ticket type'),
        { 'width': 'auto' }
    ) }}

    {{ fields.checkboxField(
        'is_recursive',
        config.fields['is_recursive'],
        __('Recursive'),
        { 'width': 'auto' }
    ) }}

</div>

{% endif %}

{% endblock %}
